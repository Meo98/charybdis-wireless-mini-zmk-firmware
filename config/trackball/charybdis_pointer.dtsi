#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&trackball_listener {
    /* base processor chain on all layers */
    input-processors = <&zip_xy_scaler 5 5>;

    /* Scroll-Ebene.
       ACHTUNG: Input-Prozessoren binden an die POSITION einer Ebene,
       nicht an ihren Namen. Wird die Reihenfolge in ZMK Studio
       geaendert, zeigt diese Zahl auf die falsche Ebene -- genau das
       war hier passiert. Angepasst an meos Reihenfolge:
           0 Base  1 Num  2 Nav  3 Sym  4 Game  5 Slow  6 Scroll  7 Xtra */
    scroller: scroller {
        layers           = <6>;
        input-processors = <
            &zip_xy_scaler 1 15                              // Scales the scroll speed
            &zip_xy_to_scroll_mapper                         // Converts XY movement to scroll events
            &zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT) // Inverts the scroll direction
        >;
    };

    /* Langsam-Ebene, siehe Hinweis oben. */
    slow_pointer: slow_pointer {
        layers           = <5>;
        input-processors = <&zip_xy_scaler 2 6>;
    };
};

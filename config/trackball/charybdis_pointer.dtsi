#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/*
 * TESTSTAND 11.10.: Diese Datei ist auf dem v4-Stand (scroller 7,
 * slow_pointer 6). Die Ebenen PRECISE/TURBO existieren in der Keymap,
 * werden hier aber bewusst NICHT angesprochen.
 *
 * Zweck: v5 enthielt zwei Aenderungen gleichzeitig -- zwei neue Ebenen
 * UND neue Zeiger-Prozessoren. Seitdem senden die Tap-Hold-Tasten ihr
 * Zeichen nicht mehr. Dieser Bau laesst nur die Ebenen uebrig und
 * zeigt damit, welche der beiden Aenderungen schuld ist.
 *
 * Die Zahlen sind Ebenen-IDs, keine Positionen.
 *   ID 6 = SLOW   ID 7 = SCROLL
 */

&trackball_listener {
    input-processors = <&zip_xy_scaler 5 5>;

    scroller: scroller {
        layers           = <7>;
        input-processors = <
            &zip_xy_scaler 1 15
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)
        >;
    };

    slow_pointer: slow_pointer {
        layers           = <6>;
        input-processors = <&zip_xy_scaler 2 6>;
    };
};
